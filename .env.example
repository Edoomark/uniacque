# ---------- Client-side (PUBLIC_*, embedded nel build Astro) ----------

# Base URL pubblico del bucket R2 (senza slash finale)
# Esempio produzione: https://cdn.uniacque.it
# In sviluppo puoi usare l'URL pubblico del bucket R2 (es. https://pub-xxxxx.r2.dev)
PUBLIC_R2_BASE_URL=

# Cloudflare Stream customer subdomain (per iframe embed)
# Esempio: customer-abc123.cloudflarestream.com
PUBLIC_STREAM_SUBDOMAIN=

# URL area riservata Uniacque (Accedi / Registrati)
PUBLIC_AUTH_LOGIN_URL=https://areariservata.uniacque.bg.it/login
PUBLIC_AUTH_REGISTER_URL=https://areariservata.uniacque.bg.it/register

# Cloudflare Web Analytics beacon token (cookieless, GDPR-safe)
# Dashboard: https://dash.cloudflare.com/?to=/:account/web-analytics (crea site, copia il token)
# Lasciare vuoto per disabilitare il tracking (es. in locale).
PUBLIC_WEB_ANALYTICS_TOKEN=

# Cloudflare Image Resizing on/off (richiede plan Pro+ e dominio Cloudflare).
# 1 = abilita l'uso di /cdn-cgi/image/... in R2Image per servire WebP/AVIF responsive.
# vuoto o altro = disabilitato, le immagini R2 vengono servite direttamente.
PUBLIC_CF_IMAGE_RESIZING=

# ---------- Server-side (solo Pages Functions, NON embedded nel build) ----------
# Aggiungi queste in Cloudflare Pages > Settings > Environment variables (Production + Preview).
# NON metterle qui in produzione, solo in .env locale per test.

# Resend API key (invio email transazionale del form)
# Ottieni da: https://resend.com/api-keys
RESEND_API_KEY=

# Destinatario delle email dal form (casella Uniacque)
CONTACT_TO_EMAIL=educational@uniacque.bg.it

# Mittente delle email (dominio verificato in Resend, es. no-reply@scuole.uniacque.bg.it)
CONTACT_FROM_EMAIL=
