---
import { r2Url, cfImage, cfSrcset } from '@lib/r2';

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'auto' | 'sync' | 'async';
  width?: number;
  height?: number;
  sizes?: string;
  widths?: number[];
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  decoding = 'async',
  width,
  height,
  sizes,
  widths,
} = Astro.props;

const absolute = r2Url(src);
const url = cfImage(absolute, { width, height });
const srcset = widths ? cfSrcset(absolute, widths) : '';
---

<img
  src={url}
  srcset={srcset || undefined}
  sizes={sizes}
  alt={alt}
  class={className}
  loading={loading}
  decoding={decoding}
  width={width}
  height={height}
/>
