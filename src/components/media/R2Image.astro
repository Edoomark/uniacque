---
import { r2Url } from '@lib/r2';

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'auto' | 'sync' | 'async';
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  decoding = 'async',
  width,
  height,
} = Astro.props;

const url = r2Url(src);
---

<img
  src={url}
  alt={alt}
  class={className}
  loading={loading}
  decoding={decoding}
  width={width}
  height={height}
/>
