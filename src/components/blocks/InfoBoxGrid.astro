---
import InfoBox from './InfoBox.astro';

interface InfoBoxItem {
  label: string;
  value: string;
  icon?: string;
}

interface Props {
  items: InfoBoxItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

{items.length > 0 && (
  <div class={`grid gap-4 sm:grid-cols-2 ${className}`}>
    {items.map((item) => (
      <InfoBox label={item.label} value={item.value} icon={item.icon} />
    ))}
  </div>
)}
