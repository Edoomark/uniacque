---
import R2Image from '@components/media/R2Image.astro';

interface Props {
  title: string;
  description: string;
  image: { src: string; alt: string };
  illustration?: string;
  href: string;
  cta: string;
  accent?: 'blue' | 'orange';
}

const { title, description, image, illustration, href, cta, accent = 'blue' } = Astro.props;

const ringClass = accent === 'orange' ? 'ring-warm/20' : 'ring-accent/40';
const dotClass = accent === 'orange' ? 'bg-warm' : 'bg-primary';
---

<a
  href={href}
  class={`group relative flex flex-col overflow-hidden rounded-card bg-white shadow-sm ring-1 ${ringClass} transition-all duration-300 hover:-translate-y-1 hover:shadow-xl`}
>
  <div class="relative aspect-[16/10] overflow-hidden bg-accent-soft">
    <R2Image
      src={image.src}
      alt={image.alt}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    {illustration && (
      <img
        src={illustration}
        alt=""
        class="pointer-events-none absolute -right-3 -top-3 h-24 w-24 object-contain drop-shadow-lg transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-110"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  <div class="flex flex-1 flex-col gap-3 p-6">
    <h3 class="font-display text-2xl font-bold text-primary">{title}</h3>
    <p class="flex-1 text-ink-soft leading-relaxed">{description}</p>
    <span
      class="mt-2 inline-flex items-center gap-2 font-semibold text-warm transition-transform group-hover:translate-x-1"
    >
      <span class={`inline-block h-1.5 w-1.5 rounded-full ${dotClass}`}></span>
      {cta}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</a>
