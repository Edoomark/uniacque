---
import R2Image from '@components/media/R2Image.astro';

interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
  columns?: 2 | 3 | 4;
  class?: string;
}

const { images, columns = 3, class: className = '' } = Astro.props;

const gridCols = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4',
};
---

{images.length > 0 && (
  <div class={`grid gap-4 ${gridCols[columns]} ${className}`}>
    {images.map((img) => (
      <figure class="overflow-hidden rounded-box bg-surface-alt">
        <R2Image
          src={img.src}
          alt={img.alt}
          class="aspect-square h-full w-full object-cover transition-transform duration-500 hover:scale-105"
        />
        {img.caption && (
          <figcaption class="p-3 text-sm text-ink-soft">{img.caption}</figcaption>
        )}
      </figure>
    ))}
  </div>
)}
