---
interface Props {
  label: string;
  value: string;
  icon?: string;
}

const { label, value } = Astro.props;
---

<div class="relative overflow-hidden rounded-card bg-accent-soft p-6 ring-1 ring-accent/40">
  <span class="absolute right-4 top-4 h-2 w-2 rounded-full bg-warm"></span>
  <p class="text-xs font-semibold uppercase tracking-wider text-warm">{label}</p>
  <p class="mt-2 font-display text-lg font-semibold text-primary leading-snug" set:html={value}></p>
</div>
