---
interface Props {
  label: string;
  value: string;
  icon?: string;
}

const { label, value } = Astro.props;
---

<div class="rounded-box bg-accent p-6 text-primary">
  <p class="text-sm font-semibold uppercase tracking-wide opacity-80">{label}</p>
  <p class="mt-2 text-lg font-medium" set:html={value}></p>
</div>
