---
import Button from '@components/ui/Button.astro';
import Container from '@components/ui/Container.astro';
import { site } from '@data/site';

interface Props {
  id?: string;
}

const { id = 'contatti' } = Astro.props;
---

<section id={id} class="bg-primary py-16 sm:py-24 text-white">
  <Container size="md">
    <div class="text-center">
      <h2 class="text-3xl sm:text-4xl font-bold">Contattaci</h2>
      <p class="mt-3 text-lg opacity-90">
        Scrivici per informazioni su percorsi, iscrizioni o collaborazioni.
      </p>
    </div>

    <form
      data-contact-form
      class="mt-10 grid gap-4 rounded-card bg-white p-6 sm:p-10 text-ink shadow-lg"
      action="/api/contact"
      method="post"
      novalidate
    >
      <input
        type="text"
        name="sito_web"
        tabindex="-1"
        autocomplete="off"
        class="hidden"
        aria-hidden="true"
      />
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium">Nome e cognome</span>
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            class="mt-1 w-full rounded-box border border-surface-alt bg-surface px-4 py-3 focus:border-primary focus:outline-none"
          />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="mt-1 w-full rounded-box border border-surface-alt bg-surface px-4 py-3 focus:border-primary focus:outline-none"
          />
        </label>
      </div>
      <label class="block">
        <span class="text-sm font-medium">Istituto scolastico</span>
        <input
          type="text"
          name="school"
          autocomplete="organization"
          class="mt-1 w-full rounded-box border border-surface-alt bg-surface px-4 py-3 focus:border-primary focus:outline-none"
        />
      </label>
      <label class="block">
        <span class="text-sm font-medium">Messaggio</span>
        <textarea
          name="message"
          rows="5"
          required
          class="mt-1 w-full rounded-box border border-surface-alt bg-surface px-4 py-3 focus:border-primary focus:outline-none"
        ></textarea>
      </label>

      <div class="flex items-center justify-between gap-4">
        <p class="text-xs text-ink-soft">
          Inviando accetti la <a href={site.privacyUrl} class="underline">privacy policy</a>.
        </p>
        <Button variant="primary" size="md" type="submit">Invia</Button>
      </div>

      <p
        data-contact-status
        class="hidden rounded-box px-4 py-3 text-sm"
        role="status"
        aria-live="polite"
      ></p>
    </form>
  </Container>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-contact-status]');

  const formStartedAt = Date.now();

  const CRM_ENDPOINT = 'https://skillherz-crm.sviluppo-4bd.workers.dev/v1/submit';
  const CRM_PUBLIC_KEY = 'pub_test_GnZKqBCAAFHxXNMzcZTO1lOVZZ4FaVzz';
  const CRM_CONSENT_VERSION = 'v1-modulouniacque';

  function sendToCRM(formData: FormData) {
    try {
      const url = new URL(window.location.href);
      const params = url.searchParams;

      const payload = {
        consenso_versione: CRM_CONSENT_VERSION,
        consenso_privacy: 'si',
        sito_web: String(formData.get('sito_web') ?? ''),
        'nome e cognome': String(formData.get('name') ?? ''),
        email: String(formData.get('email') ?? ''),
        'Istituto Scolastico': String(formData.get('school') ?? ''),
        Messaggio: String(formData.get('message') ?? ''),
        campagna: 'Modulo Uniacque',
        pagina: url.pathname + url.search,
        utm_source: params.get('utm_source') ?? '',
        utm_medium: params.get('utm_medium') ?? '',
        utm_campaign: params.get('utm_campaign') ?? '',
        secondi: Math.round((Date.now() - formStartedAt) / 1000),
      };

      fetch(CRM_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'text/plain;charset=utf-8',
          'X-CRM-Key': CRM_PUBLIC_KEY,
        },
        body: JSON.stringify(payload),
        keepalive: true,
      })
        .then((res) => {
          if (!res.ok) console.warn('[CRM Skillherz] HTTP', res.status);
        })
        .catch((err) => console.warn('[CRM Skillherz] network error', err));
    } catch (err) {
      console.warn('[CRM Skillherz] payload error', err);
    }
  }

  function setStatus(kind: 'ok' | 'err', msg: string) {
    if (!status) return;
    status.textContent = msg;
    status.classList.remove('hidden', 'bg-green-100', 'text-green-800', 'bg-red-100', 'text-red-800');
    if (kind === 'ok') status.classList.add('bg-green-100', 'text-green-800');
    else status.classList.add('bg-red-100', 'text-red-800');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;

    sendToCRM(new FormData(form));

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { accept: 'application/json' },
      });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };

      if (res.ok && data.ok) {
        form.reset();
        setStatus('ok', 'Messaggio inviato. Ti risponderemo al più presto.');
      } else {
        const map: Record<string, string> = {
          'missing-fields': 'Compila tutti i campi obbligatori.',
          'invalid-email': 'Indirizzo email non valido.',
          'send-failed': 'Invio non riuscito, riprova tra qualche minuto.',
        };
        setStatus('err', map[data.error ?? ''] ?? 'Errore imprevisto, riprova.');
      }
    } catch {
      setStatus('err', 'Errore di rete, controlla la connessione e riprova.');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
