---
import Button from '@components/ui/Button.astro';
import Container from '@components/ui/Container.astro';
import { site } from '@data/site';

interface Props {
  id?: string;
}

const { id = 'contatti' } = Astro.props;
---

<section id={id} class="bg-primary py-16 sm:py-24 text-white">
  <Container size="md">
    <div class="text-center">
      <h2 class="text-3xl sm:text-4xl font-bold">Contattaci</h2>
      <p class="mt-3 text-lg opacity-90">
        Scrivici per informazioni su percorsi, iscrizioni o collaborazioni.
      </p>
    </div>

    <form
      class="mt-10 grid gap-4 rounded-card bg-white p-6 sm:p-10 text-ink shadow-lg"
      action={`mailto:${site.contactEmail}`}
      method="post"
      enctype="text/plain"
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium">Nome e cognome</span>
          <input
            type="text"
            name="name"
            required
            class="mt-1 w-full rounded-box border border-surface-alt bg-surface px-4 py-3 focus:border-primary focus:outline-none"
          />
        </label>
        <label class="block">
          <span class="text-sm font-medium">Email</span>
          <input
            type="email"
            name="email"
            required
            class="mt-1 w-full rounded-box border border-surface-alt bg-surface px-4 py-3 focus:border-primary focus:outline-none"
          />
        </label>
      </div>
      <label class="block">
        <span class="text-sm font-medium">Istituto scolastico</span>
        <input
          type="text"
          name="school"
          class="mt-1 w-full rounded-box border border-surface-alt bg-surface px-4 py-3 focus:border-primary focus:outline-none"
        />
      </label>
      <label class="block">
        <span class="text-sm font-medium">Messaggio</span>
        <textarea
          name="message"
          rows="5"
          required
          class="mt-1 w-full rounded-box border border-surface-alt bg-surface px-4 py-3 focus:border-primary focus:outline-none"
        ></textarea>
      </label>
      <div class="flex items-center justify-between gap-4">
        <p class="text-xs text-ink-soft">
          Inviando accetti la <a href={site.privacyUrl} class="underline">privacy policy</a>.
        </p>
        <Button variant="primary" size="md">Invia</Button>
      </div>
    </form>
  </Container>
</section>
