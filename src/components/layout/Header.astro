---
import Container from '@components/ui/Container.astro';
import { site, nav } from '@data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';

function isActive(href: string): boolean {
  if (href.startsWith('#')) return false;
  const clean = href.replace(/\/$/, '') || '/';
  if (clean === '/') return currentPath === '/';
  return currentPath === clean || currentPath.startsWith(clean + '/');
}

function resolveHref(href: string): string {
  if (href.startsWith('#') && !isHome) return `/${href}`;
  return href;
}

function hashOf(href: string): string | undefined {
  const idx = href.indexOf('#');
  return idx === -1 ? undefined : href.slice(idx);
}

const linkBase =
  'relative inline-flex items-center rounded-full px-4 py-2 font-display text-sm font-semibold transition-colors text-ink hover:text-primary hover:bg-accent-soft/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-warm focus-visible:ring-offset-2 aria-[current=page]:bg-warm/10 aria-[current=page]:text-warm-ink after:absolute after:inset-x-4 after:bottom-1 after:h-0.5 after:rounded-full after:bg-warm after:opacity-0 aria-[current=page]:after:opacity-100 after:transition-opacity';

const mobileLinkBase =
  'block rounded-box px-4 py-3 font-display text-base font-semibold transition-colors text-ink hover:bg-accent-soft hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-warm focus-visible:ring-inset aria-[current=page]:bg-warm/10 aria-[current=page]:text-warm-ink';
---

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur shadow-[0_1px_0_var(--color-accent-soft)]">
  <Container size="xl" class="flex items-center justify-between py-3 sm:py-4">
    <a
      href="/"
      class="group inline-flex items-center rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-warm focus-visible:ring-offset-2"
      aria-label={`${site.shortName} — homepage`}
    >
      <img
        src="/logo-uniacque-educational.png"
        alt={site.shortName}
        class="h-10 sm:h-12 w-auto transition-transform group-hover:scale-[1.02]"
        width="240"
        height="80"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav aria-label="Navigazione principale" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => {
          const active = isActive(item.href);
          const hash = hashOf(item.href);
          return (
            <li>
              <a
                href={resolveHref(item.href)}
                aria-current={active ? 'page' : undefined}
                data-hash={hash}
                class={linkBase}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <button
      class="md:hidden rounded-full p-2 text-primary hover:bg-accent-soft"
      aria-label="Apri menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-menu-toggle
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
      </svg>
    </button>
  </Container>

  <nav
    id="mobile-menu"
    class="hidden md:hidden border-t border-accent-soft bg-white"
    aria-label="Navigazione mobile"
  >
    <ul class="flex flex-col gap-1 p-4">
      {nav.map((item) => {
        const active = isActive(item.href);
        const hash = hashOf(item.href);
        return (
          <li>
            <a
              href={resolveHref(item.href)}
              aria-current={active ? 'page' : undefined}
              data-hash={hash}
              class={mobileLinkBase}
            >
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    const focusableSelector = 'a[href], button:not([disabled])';

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Chiudi menu' : 'Apri menu');
      document.body.classList.toggle('overflow-hidden', open);
      if (open) {
        menu.querySelector<HTMLElement>(focusableSelector)?.focus();
      } else {
        btn.focus();
      }
    };

    btn.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });

    document.addEventListener('keydown', (e) => {
      if (menu.classList.contains('hidden')) return;
      if (e.key === 'Escape') {
        setOpen(false);
        return;
      }
      if (e.key === 'Tab') {
        const nodes = Array.from(menu.querySelectorAll<HTMLElement>(focusableSelector));
        if (nodes.length === 0) return;
        const first = nodes[0];
        const last = nodes[nodes.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false))
    );
  }
</script>
