---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import CtaPair from '@components/blocks/CtaPair.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'area-didattica');
if (!page) throw new Error('Missing pages/area-didattica entry');

const { title, seo } = page.data;
const { Content } = await render(page);

const resources = [
  {
    title: 'Approfondimenti',
    description: 'Contenuti tematici sul ciclo dell\u2019acqua.',
    icon: '/illustrations/doc.png',
  },
  {
    title: 'Giochi',
    description: 'Attivit\u00e0 ludico-didattiche.',
    icon: '/illustrations/roboto.png',
  },
  {
    title: 'Laboratori',
    description: 'Schede operative da svolgere in classe.',
    icon: '/illustrations/laboratory.png',
  },
  {
    title: 'Esperimenti',
    description: 'Protocolli pratici.',
    icon: '/illustrations/design-science.png',
  },
  {
    title: 'Pillole',
    description: 'Brevi video divulgativi.',
    icon: '/illustrations/vr.png',
  },
];
---

<BaseLayout title={title} description={seo.description} ogImage={seo.ogImage}>
  <section class="relative overflow-hidden bg-primary text-white min-h-[620px] sm:min-h-[680px]">
    <!-- Dots pattern -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.08]"
      style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 34px 34px;"
      aria-hidden="true"
    ></div>

    <!-- Blobs -->
    <div class="pointer-events-none absolute -top-32 -left-24 h-96 w-96 rounded-full bg-primary-light opacity-50 blur-3xl"></div>
    <div class="pointer-events-none absolute top-1/3 right-10 h-80 w-80 rounded-full bg-warm opacity-25 blur-3xl"></div>

    <Container size="xl" class="relative py-20 sm:py-28 lg:py-32">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="relative z-10 max-w-2xl">
          <span class="inline-block h-1 w-14 rounded-full bg-warm"></span>
          <h1 class="mt-5 font-display text-5xl sm:text-6xl lg:text-7xl font-bold leading-[0.95]">
            {title}
          </h1>
          <p class="mt-6 text-lg sm:text-xl text-white/85 leading-relaxed">
            Accedi all'area riservata per prenotare le attività, scaricare i materiali
            didattici e vedere i video prodotti nell'ambito della Formazione Scuola-Lavoro.
          </p>
          <CtaPair class="mt-8" />
        </div>

        <div class="relative mx-auto w-full max-w-md lg:max-w-none">
          <div class="pointer-events-none absolute inset-0 -z-10 scale-125 rounded-full bg-primary-light/40 blur-2xl"></div>
          <img
            src="/illustrations/graduation.png"
            alt=""
            class="relative mx-auto w-full max-w-[440px] rotate-[-4deg] drop-shadow-[0_30px_60px_rgba(0,0,0,0.35)]"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-white py-12 sm:py-16">
    <Container size="lg">
      <div class="rounded-card bg-accent-cloud p-6 sm:p-8 ring-1 ring-accent/40 prose prose-lg max-w-none">
        <Content />
      </div>
    </Container>
  </section>

  <section class="bg-accent-cloud py-14 sm:py-20">
    <Container size="lg">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {resources.map((r) => (
          <article class="group relative flex flex-col items-start gap-5 rounded-card bg-white p-7 shadow-sm ring-1 ring-accent/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
            <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-md ring-1 ring-primary/10">
              <img
                src={r.icon}
                alt=""
                class="h-11 w-11 object-contain"
                loading="lazy"
                decoding="async"
              />
            </span>
            <div>
              <h3 class="font-display text-xl font-bold text-primary">{r.title}</h3>
              <p class="mt-2 text-ink-soft leading-relaxed">{r.description}</p>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
