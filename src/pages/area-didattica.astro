---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import CtaPair from '@components/blocks/CtaPair.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'area-didattica');
if (!page) throw new Error('Missing pages/area-didattica entry');

const { title, seo } = page.data;
const { Content } = await render(page);
---

<BaseLayout title={title} description={seo.description} ogImage={seo.ogImage}>
  <section class="relative overflow-hidden bg-primary text-white min-h-[620px] sm:min-h-[680px]">
    <!-- Dots pattern -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.08]"
      style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 34px 34px;"
      aria-hidden="true"
    ></div>

    <!-- Blobs -->
    <div class="pointer-events-none absolute -top-32 -left-24 h-96 w-96 rounded-full bg-primary-light opacity-50 blur-3xl"></div>
    <div class="pointer-events-none absolute top-1/3 right-10 h-80 w-80 rounded-full bg-warm opacity-25 blur-3xl"></div>

    <Container size="xl" class="relative py-20 sm:py-28 lg:py-32">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="relative z-10 max-w-2xl">
          <span class="inline-block h-1 w-14 rounded-full bg-warm"></span>
          <h1 class="mt-5 font-display text-5xl sm:text-6xl lg:text-7xl font-bold leading-[0.95]">
            {title}
          </h1>
          <p class="mt-6 text-lg sm:text-xl text-white/85 leading-relaxed">
            Accedi all'area riservata per prenotare le attività, scaricare i materiali
            didattici e vedere i video prodotti nell'ambito della Formazione Scuola-Lavoro.
          </p>
          <CtaPair class="mt-8" />
        </div>

        <div class="relative mx-auto w-full max-w-md lg:max-w-none">
          <div class="pointer-events-none absolute inset-0 -z-10 scale-125 rounded-full bg-primary-light/40 blur-2xl"></div>
          <img
            src="/illustrations/graduation.png"
            alt=""
            class="relative mx-auto w-full max-w-[440px] rotate-[-4deg] drop-shadow-[0_30px_60px_rgba(0,0,0,0.35)]"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </Container>
  </section>

  <Container size="md" class="py-14 sm:py-20 prose prose-lg max-w-none">
    <Content />
  </Container>
</BaseLayout>
