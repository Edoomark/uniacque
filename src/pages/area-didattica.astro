---
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import HeroCard from '@components/blocks/HeroCard.astro';
import AuthCtaCard from '@components/blocks/AuthCtaCard.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'area-didattica');
if (!page) throw new Error('Missing pages/area-didattica entry');

const { title, seo } = page.data;
const { Content } = await render(page);

const intro = "Accedi all'area riservata per prenotare le attività, scaricare le schede didattiche pronte all'uso e guardare le pillole video realizzate dai ragazzi durante le settimane di Formazione Scuola-Lavoro.";

const resources = [
  {
    title: 'Approfondimenti',
    description: 'Scarica infografiche e illustrazioni per le tue lezioni.',
    icon: '/illustrations/doc.png',
  },
  {
    title: 'Giochi',
    description: 'Scarica e gioca con gli studenti.',
    icon: '/illustrations/roboto.png',
  },
  {
    title: 'Laboratori',
    description: 'Scarica e utilizza in classe o a casa i materiali educativi per fare attivit\u00e0 di laboratorio.',
    icon: '/illustrations/laboratory.png',
  },
  {
    title: 'Esperimenti',
    description: 'Guarda e ricrea gli esperimenti con gli studenti.',
    icon: '/illustrations/design-science.png',
  },
  {
    title: 'Pillole',
    description: 'Le settimane di FSL promosse ogni anno da Uniacque diventano video in cui l\u2019acqua viene spiegata dai ragazzi ai ragazzi.',
    icon: '/illustrations/vr.png',
  },
];
---

<BaseLayout title={title} description={seo.description} ogImage={seo.ogImage}>
  <HeroCard
    title={title}
    eyebrow="Area riservata"
    illustration="/illustrations/mc-eolica.png"
  />

  <section class="py-14 sm:py-20 bg-accent-cloud">
    <Container size="lg">
      <article class="relative rounded-card bg-white p-8 sm:p-12 shadow-lg ring-1 ring-accent/30 prose prose-lg max-w-none">
        <p>{intro}</p>
      </article>
      <div class="mt-6" data-auth-cta>
        <AuthCtaCard />
      </div>
    </Container>
  </section>

  <!-- Contenuto riservato: visibile solo post accesso -->
  <div id="auth-gated" hidden>
    <section class="py-14 sm:py-20 bg-accent-cloud">
      <Container size="lg">
        <article class="relative rounded-card bg-white p-8 sm:p-12 shadow-lg ring-1 ring-accent/30 prose prose-lg max-w-none">
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-primary mt-0">Risorse</h2>
          <Content />
        </article>
      </Container>
    </section>

    <section class="bg-accent-cloud pb-20">
      <Container size="lg">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {resources.map((r) => (
            <article class="group relative flex flex-col items-start gap-5 rounded-card bg-white p-7 shadow-sm ring-1 ring-accent/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
              <span class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-md ring-1 ring-primary/10">
                <img
                  src={r.icon}
                  alt=""
                  class="h-11 w-11 object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <div>
                <h3 class="font-display text-xl font-bold text-primary">{r.title}</h3>
                <p class="mt-2 text-ink-soft leading-relaxed">{r.description}</p>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </section>
  </div>
</BaseLayout>

<script>
  const AUTH_KEY = 'uniacque_auth_v2';
  const LEGACY_KEY = 'uniacque_auth';
  const gated = document.getElementById('auth-gated');

  try { localStorage.removeItem(LEGACY_KEY); } catch {}

  const params = new URLSearchParams(window.location.search);
  if (params.get('auth') === '1') {
    try { localStorage.setItem(AUTH_KEY, '1'); } catch {}
  }

  let authed = false;
  try { authed = localStorage.getItem(AUTH_KEY) === '1'; } catch {}
  if (authed && gated) gated.hidden = false;
</script>
