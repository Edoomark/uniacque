---
import BaseLayout from '@layouts/BaseLayout.astro';
import HomeFeatureCard from '@components/blocks/HomeFeatureCard.astro';
import ContactForm from '@components/blocks/ContactForm.astro';
import Container from '@components/ui/Container.astro';
import HeroCard from '@components/blocks/HeroCard.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing pages/home entry');

const { title, hero, intro, features, seo } = page.data;
const { Content } = await render(page);
const hasBody = (page.body ?? '').trim().length > 0;

const illustrationMap: Record<string, string> = {
  Educational: '/illustrations/laboratory.png',
  'Water School': '/illustrations/vr.png',
  'Area didattica': '/illustrations/graduation.png',
  News: '/illustrations/doc.png',
};
---

<BaseLayout title={title} description={seo.description} ogImage={seo.ogImage}>
  <HeroCard
    title={title}
    intro={intro}
    hero={hero}
    illustration="/illustrations/mc-persona-v2.png"
  />

  {hasBody && (
    <section class="py-14 sm:py-20">
      <Container size="lg">
        <article class="relative rounded-card bg-white p-8 sm:p-12 shadow-lg ring-1 ring-accent/30 prose prose-lg max-w-none">
          <Content />
        </article>
      </Container>
    </section>
  )}

  <section class="py-12 sm:py-20 bg-accent-cloud">
    <Container size="xl">
      <div class="grid gap-6 sm:grid-cols-2">
        {features.map((f, i) => (
          <HomeFeatureCard
            title={f.title}
            description={f.description}
            image={f.image}
            illustration={illustrationMap[f.title]}
            href={f.cta.href}
            cta={f.cta.label}
            accent={i % 2 === 0 ? 'blue' : 'orange'}
          />
        ))}
      </div>
    </Container>
  </section>

  <ContactForm />
</BaseLayout>
