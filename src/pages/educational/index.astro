---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroCard from '@components/blocks/HeroCard.astro';
import FeatureGrid from '@components/blocks/FeatureGrid.astro';
import Container from '@components/ui/Container.astro';
import { getEntry, getCollection, render } from 'astro:content';

const page = await getEntry('pages', 'educational');
if (!page) throw new Error('Missing pages/educational entry');

const { title, hero, intro, seo } = page.data;
const { Content } = await render(page);
const hasBody = (page.body ?? '').trim().length > 0;

const programs = (await getCollection('programs')).sort(
  (a, b) => a.data.order - b.data.order
);

const illustrationMap: Record<string, string> = {
  'educational-center': '/illustrations/laboratory.png',
  'fsl': '/illustrations/roboto.png',
  'missione-comune': '/illustrations/mc-rubinetto.png',
  'sorgente-nossana': '/illustrations/design-science.png',
};

const features = programs.map((p) => ({
  title: p.data.title,
  description: p.data.summary,
  image:
    p.data.cardImage ??
    (p.data.hero.type === 'image'
      ? p.data.hero.image
      : { src: p.data.hero.video.poster ?? '', alt: p.data.hero.video.alt }),
  cta: { label: 'Scopri di più', href: `/educational/${p.id}`, variant: 'primary' as const },
  illustration: illustrationMap[p.id],
}));
---

<BaseLayout title={title} description={seo.description} ogImage={seo.ogImage}>
  {hero && (
    <HeroCard
      title={title}
      intro={intro}
      hero={hero}
      illustration="/illustrations/graduation.png"
    />
  )}

  {hasBody && (
    <Container size="lg" class="py-12 prose prose-lg max-w-none">
      <Content />
    </Container>
  )}

  <section class="relative py-16 sm:py-24 bg-accent-cloud">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background-image: radial-gradient(circle, var(--color-accent) 1px, transparent 1px); background-size: 32px 32px;"
      aria-hidden="true"
    ></div>
    <Container size="xl" class="relative">
      <FeatureGrid features={features} columns={2} />
    </Container>
  </section>
</BaseLayout>
