---
import BaseLayout from './BaseLayout.astro';
import Container from '@components/ui/Container.astro';
import R2Image from '@components/media/R2Image.astro';
import Video from '@components/media/Video.astro';
import Gallery from '@components/blocks/Gallery.astro';
import RelatedArticles from '@components/blocks/RelatedArticles.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'news'>;
  related: Array<{
    slug: string;
    title: string;
    date: Date;
    excerpt: string;
    cover: { src: string; alt: string };
  }>;
}

const { article, related } = Astro.props;
const { title, date, cover, gallery, video, seo } = article.data;

const fmt = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={title}
  description={seo?.description ?? article.data.excerpt}
  ogImage={seo?.ogImage}
>
  <article>
    <div class="bg-primary pt-8 pb-24 sm:pt-12 sm:pb-32">
      <Container size="xl">
        <div class="overflow-hidden rounded-hero aspect-[16/7]">
          <R2Image src={cover.src} alt={cover.alt} class="h-full w-full object-cover" loading="eager" />
        </div>
      </Container>
    </div>

    <Container size="md" class="relative -mt-20 sm:-mt-28">
      <div class="rounded-card bg-white p-6 sm:p-10 shadow-lg">
        <time class="text-sm text-ink-soft">{fmt.format(date)}</time>
        <h1 class="mt-2 text-3xl sm:text-4xl font-bold text-primary">{title}</h1>
      </div>
    </Container>

    <Container size="md" class="prose prose-lg max-w-none py-12">
      <slot />
    </Container>

    {video && (
      <Container size="lg" class="pb-12">
        <Video video={video} class="rounded-hero" />
      </Container>
    )}

    {gallery && gallery.length > 0 && (
      <Container size="xl" class="pb-16">
        <Gallery images={gallery} columns={3} />
      </Container>
    )}
  </article>

  {related.length > 0 && <RelatedArticles items={related} />}
</BaseLayout>
