---
import BaseLayout from './BaseLayout.astro';
import HeroCard from '@components/blocks/HeroCard.astro';
import InfoBoxGrid from '@components/blocks/InfoBoxGrid.astro';
import CtaPair from '@components/blocks/CtaPair.astro';
import Gallery from '@components/blocks/Gallery.astro';
import VideoGallery from '@components/blocks/VideoGallery.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  program: CollectionEntry<'programs'>;
}

const { program } = Astro.props;
const { title, hero, intro, infoBoxes, ctas, gallery, note, contactEmail, seo } = program.data;
---

<BaseLayout title={title} description={seo.description} ogImage={seo.ogImage}>
  <HeroCard title={title} eyebrow="Educational" intro={intro} hero={hero}>
    <CtaPair class="mt-6" />
    {ctas.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-3">
        {ctas.map((c) => (
          <Button href={c.href} variant={c.variant}>{c.label}</Button>
        ))}
      </div>
    )}
  </HeroCard>

  <section class="py-12 sm:py-16">
    <Container size="lg" class="prose prose-lg max-w-none">
      <slot />
    </Container>
  </section>

  {infoBoxes.length > 0 && (
    <section class="py-8 sm:py-12">
      <Container size="lg">
        <InfoBoxGrid items={infoBoxes} />
      </Container>
    </section>
  )}

  {note && (
    <section class="pb-8">
      <Container size="lg">
        <div class="rounded-box border-l-4 border-warm bg-warm/10 p-4 text-ink-soft">
          {note}
        </div>
      </Container>
    </section>
  )}

  {contactEmail && (
    <section class="pb-8">
      <Container size="lg">
        <p class="text-ink-soft">
          Per informazioni scrivi a
          <a href={`mailto:${contactEmail}`} class="text-primary underline">{contactEmail}</a>.
        </p>
      </Container>
    </section>
  )}

  {gallery?.images && gallery.images.length > 0 && (
    <section class="py-12 sm:py-16 bg-surface-alt">
      <Container size="xl">
        <h2 class="mb-8 text-2xl sm:text-3xl font-bold text-primary">Galleria</h2>
        <Gallery images={gallery.images} columns={3} />
      </Container>
    </section>
  )}

  {gallery?.videos && gallery.videos.length > 0 && (
    <section class="py-12 sm:py-16">
      <Container size="xl">
        <h2 class="mb-8 text-2xl sm:text-3xl font-bold text-primary">Video</h2>
        <VideoGallery videos={gallery.videos} columns={2} />
      </Container>
    </section>
  )}
</BaseLayout>
