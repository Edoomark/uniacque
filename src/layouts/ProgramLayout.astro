---
import BaseLayout from './BaseLayout.astro';
import HeroCard from '@components/blocks/HeroCard.astro';
import InfoBoxGrid from '@components/blocks/InfoBoxGrid.astro';
import AuthCtaCard from '@components/blocks/AuthCtaCard.astro';
import Gallery from '@components/blocks/Gallery.astro';
import VideoGallery from '@components/blocks/VideoGallery.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  program: CollectionEntry<'programs'>;
}

const { program } = Astro.props;
const {
  title,
  hero,
  intro,
  infoBoxes,
  ctas,
  gallery,
  note,
  howItWorks,
  contactEmail,
  contactBlurb,
  seo,
  showAuthCta,
} = program.data;

const illustrationMap: Record<string, string> = {
  'educational-center': '/illustrations/mc-persona-v2.png',
  'fsl': '/illustrations/roboto.png',
  'missione-comune': '/illustrations/mc-palazzo-v2.png',
  'sorgente-nossana': '/illustrations/mc-rubinetto-v2.png',
};
const illustration = illustrationMap[program.id];

const hasBody = (program.body ?? '').trim().length > 0;
const hasExtraCtas = ctas.length > 0;
const hasAuthCta = showAuthCta || hasExtraCtas;
const hasComeFunziona = Boolean(howItWorks) || infoBoxes.length > 0;

const howItWorksParagraphs = howItWorks
  ? howItWorks.split(/\n\s*\n/).map((p) => p.trim()).filter((p) => p.length > 0)
  : [];

const emailLinkHtml = contactBlurb && contactEmail
  ? contactBlurb.replace(
      contactEmail,
      `<a href="mailto:${contactEmail}" class="font-semibold text-warm-soft underline decoration-warm/50 underline-offset-4 hover:text-white">${contactEmail}</a>`,
    )
  : null;
---

<BaseLayout title={title} description={seo.description} ogImage={seo.ogImage}>
  <HeroCard title={title} eyebrow="Educational" hero={hero} illustration={illustration} />

  {(intro || hasBody) && (
    <section class="py-14 sm:py-20 bg-accent-cloud">
      <Container size="lg">
        <article class="relative rounded-card bg-white p-8 sm:p-12 shadow-lg ring-1 ring-accent/30 prose prose-lg max-w-none">
          {intro && <p>{intro}</p>}
          {hasBody && <slot />}
        </article>
      </Container>
    </section>
  )}

  {hasComeFunziona && (
    <section class="py-10 sm:py-14 bg-accent-cloud">
      <Container size="lg">
        <div class="relative overflow-hidden rounded-card bg-white p-8 sm:p-12 shadow-lg ring-1 ring-accent/30">
          <div class="flex items-center gap-3">
            <span class="inline-block h-1 w-10 rounded-full bg-warm"></span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-primary">Come funziona</h2>
          </div>
          {howItWorksParagraphs.length > 0 && (
            <div class="mt-5 space-y-4 text-lg leading-relaxed text-ink">
              {howItWorksParagraphs.map((p) => <p>{p}</p>)}
            </div>
          )}
          {infoBoxes.length > 0 && (
            <div class="mt-6">
              <InfoBoxGrid items={infoBoxes} />
            </div>
          )}
        </div>
      </Container>
    </section>
  )}

  {note && (
    <section class="pb-10 bg-accent-cloud">
      <Container size="lg">
        <div class="rounded-card bg-warm-soft/60 p-5 sm:p-6 text-ink ring-1 ring-warm/20">
          {note}
        </div>
      </Container>
    </section>
  )}

  {(contactBlurb || contactEmail) && (
    <section class="pb-14 sm:pb-20 bg-accent-cloud">
      <Container size="lg">
        <div class="relative overflow-hidden rounded-card bg-primary p-6 sm:p-8 text-white shadow-lg">
          <div class="pointer-events-none absolute -top-16 -right-16 h-48 w-48 rounded-full bg-warm/15 blur-2xl"></div>
          <div class="relative">
            {emailLinkHtml ? (
              <p class="text-base sm:text-lg leading-relaxed text-white/90" set:html={emailLinkHtml} />
            ) : contactBlurb ? (
              <p class="text-base sm:text-lg leading-relaxed text-white/90">{contactBlurb}</p>
            ) : (
              <p class="text-base sm:text-lg text-white/90">
                Per informazioni scrivi a
                <a
                  href={`mailto:${contactEmail}`}
                  class="ml-1 inline-flex items-center gap-1 font-semibold text-warm-soft underline decoration-warm/50 underline-offset-4 hover:text-white"
                >
                  {contactEmail}
                </a>
              </p>
            )}
          </div>
        </div>
      </Container>
    </section>
  )}

  {hasAuthCta && (
    <section class="pb-10 sm:pb-14 bg-accent-cloud">
      <Container size="lg">
        {showAuthCta && <AuthCtaCard />}
        {hasExtraCtas && (
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            {ctas.map((c) => (
              <Button href={c.href} variant={c.variant}>{c.label}</Button>
            ))}
          </div>
        )}
      </Container>
    </section>
  )}

  {gallery?.images && gallery.images.length > 0 && (
    <section class="py-14 sm:py-20 bg-accent-cloud">
      <Container size="xl">
        <h2 class="mb-8 font-display text-2xl sm:text-3xl font-bold text-primary">Galleria</h2>
        <Gallery images={gallery.images} columns={3} />
      </Container>
    </section>
  )}

  {gallery?.videos && gallery.videos.length > 0 && (
    <section class="py-14 sm:py-20 bg-accent-cloud">
      <Container size="xl">
        <h2 class="mb-8 font-display text-2xl sm:text-3xl font-bold text-primary">Video</h2>
        <VideoGallery videos={gallery.videos} columns={2} />
      </Container>
    </section>
  )}
</BaseLayout>
